# Copy to ".env.local" and fill in values. Do not commit .env.local.

# Required for POST /api/generate
TOGETHER_API_KEY=

# Optional: chat model id on Together (default: meta-llama/Llama-3.3-70B-Instruct-Turbo)
# Must support Together JSON mode (json_schema). See: https://docs.together.ai/docs/json-mode
# Faster + more reliable JSON than Qwen2.5-7B: Qwen/Qwen3.5-9B
# Qwen2.5-7B can leak JSON keys into scene strings; prefer Llama 3.3 70B for stability.
TOGETHER_MODEL=

# Optional: Together fetch timeout in milliseconds (default: 52000)
TOGETHER_TIMEOUT_MS=
